{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#build": {
      "outputs": ["dist/**"]
    },
    "//#typecheck": {},
    "//#test": {
      "cache": false
    }
  }
}
