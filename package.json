{
  "name": "aircastle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run check:policy && tsc --noEmit",
    "build": "tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "check:policy": "bun scripts/check-code-policy.ts",
    "test:harness": "bun test tests/harness",
    "test:schema": "bun test tests/schema",
    "test:typecheck": "bun scripts/check-type-fixtures.ts contracts",
    "test:types": "bun run test:typecheck",
    "test:inference": "bun scripts/check-type-fixtures.ts inference"
  },
  "dependencies": {
    "arktype": "2.2.9"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@types/bun": "1.3.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": "1.3.4",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
