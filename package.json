{
  "name": "aircastle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter './apps/*' --parallel dev",
    "dev-web": "vp -C apps/web dev",
    "dev-api": "vp -C apps/api run dev",
    "knip": "knip",
    "build": "vp run --filter '@aircastle/*' build",
    "typecheck": "bun run check:policy && tsc --noEmit && vp run --filter '@aircastle/*' --parallel typecheck",
    "lint": "vp lint",
    "lint-web": "vp lint apps/web",
    "lint-api": "vp lint apps/api",
    "lint-schema": "vp lint packages/schema",
    "test": "bun run test:typecheck && vp run --filter '@aircastle/*' --parallel test && bun test ./tests && bun run test:inference",
    "test-web": "vp -C apps/web run test",
    "test-api": "vp -C apps/api run test",
    "test-schema": "vp -C packages/schema run test",
    "check:policy": "bun scripts/check-code-policy.ts",
    "test:harness": "bun test tests/harness packages/schema/tests/harness",
    "test:schema": "vp -C packages/schema run test:schema",
    "test:typecheck": "vp -C packages/schema run test:typecheck",
    "test:types": "bun run test:typecheck",
    "test:inference": "vp -C packages/schema run test:inference",
    "check": "bun run check:policy && bun run test",
    "test:coverage": "vp -C packages/schema run test:coverage",
    "test-mutation": "vp -C packages/schema run test:mutation",
    "test:unicode": "vp -C packages/schema run test:unicode",
    "test:declarations": "vp -C packages/schema run test:declarations",
    "test:declarations:inference": "vp -C packages/schema run test:declarations:inference",
    "test:mutation:classify": "vp -C packages/schema run test:mutation:classify"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@types/bun": "1.3.4",
    "knip": "6.42.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": "1.3.4",
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
