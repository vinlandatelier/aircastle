{
  "name": "aircastle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter './apps/*' --parallel dev",
    "dev-web": "vp -C apps/web dev",
    "dev-api": "vp -C apps/api run dev",
    "knip": "knip",
    "build": "vp run --filter '@aircastle/*' build",
    "typecheck": "bun run check:policy && tsc --noEmit && vp run --filter '@aircastle/*' --parallel typecheck",
    "lint": "vp lint --deny-warnings",
    "lint-web": "vp lint apps/web",
    "lint-api": "vp lint apps/api",
    "lint-schema": "vp lint packages/schema",
    "test": "vp run build && vp run test:prepared",
    "test-web": "vp -C apps/web run test",
    "test-api": "vp -C apps/api run test",
    "test-schema": "vp -C packages/schema run test",
    "check:policy": "bun scripts/check-code-policy.ts",
    "test:harness": "vp test tests/harness && vp -C packages/schema test tests/harness",
    "test:schema": "vp -C packages/schema run test:schema",
    "test:typecheck": "vp -C packages/schema run test:typecheck",
    "test:types": "bun run test:typecheck",
    "test:inference": "vp -C packages/schema run test:inference",
    "check": "vp run build && vp run typecheck && vp run lint && vp run knip && vp run test:prepared && vp run test-web:e2e && vp run test:db",
    "test:coverage": "vp -C packages/schema run test:coverage",
    "test-mutation": "vp -C packages/schema run test:mutation",
    "test:unicode": "vp -C packages/schema run test:unicode",
    "test:declarations": "vp -C packages/schema run test:declarations",
    "test:declarations:inference": "vp -C packages/schema run test:declarations:inference",
    "test:mutation:classify": "vp -C packages/schema run test:mutation:classify",
    "hono-api": "vp -C apps/api run hono",
    "db:up": "docker compose -f compose.yaml up -d --wait --wait-timeout 90 postgres",
    "db:down": "docker compose -f compose.yaml down",
    "db:logs": "docker compose -f compose.yaml logs --follow postgres",
    "db:reset": "docker compose -f compose.yaml down --volumes",
    "db:test": "bun scripts/with-postgres.ts",
    "test:db": "vp test --config vite.db.config.ts",
    "test:content": "vp test --config vite.content.config.ts",
    "test:content:db": "vp run db:test -- vp run test:content --project database",
    "dev:setup": "bun --conditions=development scripts/dev-setup.ts",
    "test:all": "bun run test:typecheck && vp run --filter '@aircastle/*' --parallel test && vp test && bun run test:inference",
    "test:content:mutation": "vp -C packages/contracts run test:mutation",
    "test:prepared": "vp run db:test -- vp run test:all",
    "ai:setup": "node scripts/ai-automation/cli.ts setup",
    "test-web:e2e": "vp -C apps/web run test:e2e",
    "test-web:coverage": "vp -C apps/web run test:coverage"
  },
  "devDependencies": {
    "@aircastle/adapter-postgres": "workspace:*",
    "@aircastle/client": "workspace:*",
    "@aircastle/core": "workspace:*",
    "@aircastle/schema": "workspace:*",
    "@babel/parser": "7.28.5",
    "@types/bun": "catalog:",
    "diff": "9.0.0",
    "knip": "6.42.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@types/node": "24.19.2",
    "vite": "catalog:"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "patchedDependencies": {
    "@ark/util@0.56.8": "patches/@ark%2Futil@0.56.8.patch"
  }
}
