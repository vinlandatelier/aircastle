{
  "name": "aircastle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev-web": "vp -C apps/web dev",
    "dev-api": "vp -C apps/api run dev",
    "knip": "knip",
    "typecheck": "bun run check:policy && tsc --noEmit",
    "build": "vp pack",
    "test": "bun test",
    "check:policy": "bun scripts/check-code-policy.ts",
    "test:harness": "bun test tests/harness",
    "test:schema": "bun test tests/schema",
    "test:typecheck": "bun scripts/check-type-fixtures.ts contracts && bun scripts/check-type-fixtures.ts contracts declarations",
    "test:types": "bun run test:typecheck",
    "test:inference": "bun scripts/check-type-fixtures.ts inference && bun scripts/check-type-fixtures.ts inference declarations",
    "check": "bun run check:policy && bun run test:typecheck && bun test && bun run test:inference",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:mutation": "node node_modules/@stryker-mutator/core/bin/stryker.js run && bun run test:mutation:classify",
    "test:unicode": "bun test tests/schema/unicode.test.ts",
    "test:declarations": "bun scripts/check-type-fixtures.ts contracts declarations",
    "test:declarations:inference": "bun scripts/check-type-fixtures.ts inference declarations",
    "test:mutation:classify": "bun scripts/classify-mutations.ts"
  },
  "dependencies": {
    "arktype": "2.2.9"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.3.4",
    "fast-check": "4.10.2",
    "knip": "6.42.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": "1.3.4",
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
