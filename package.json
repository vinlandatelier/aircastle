{
  "name": "aircastle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": "1.3.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
