    "test:typecheck": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "arktype": "2.2.9"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
