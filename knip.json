{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/skills/**"],
  "ignoreDependencies": ["@stryker-mutator/command-runner"],
  "ignoreUnresolved": [
    "^scripts/with-postgres\\.ts$",
    "^packages/schema/scripts/classify-mutations\\.ts$",
    "^scripts/(verify-web|test-strength)\\.ts$"
  ],
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/ai-automation/sandbox.ts"],
      "vitest": {
        "config": ["vite.content.config.ts", "vite.db.config.ts"]
      },
      "ignoreDependencies": ["vite"],
      "ignoreExportsUsedInFile": true
    },
    "apps/api": {
      "entry": ["src/{index,cli}.ts"]
    },
    "apps/web": {
      "entry": ["e2e/fixture-modules/*.ts"],
      "vitest": {
        "config": ["vite.config.ts", "vite.verification.config.ts"]
      },
      "playwright": {
        "config": [],
        "entry": ["playwright.config.ts", "e2e/**/*.spec.ts"]
      }
    },
    "packages/client": {
      "entry": ["tests/types/**/*.ts"],
      "paths": {
        "aircastle-client-under-test": ["./src/index.ts"]
      }
    },
    "packages/schema": {
      "entry": ["src/index.ts", "tests/types/**/*.ts"],
      "ignoreExportsUsedInFile": true
    }
  }
}
